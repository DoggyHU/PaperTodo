{
  "kind": "native",
  "id": "com.doggyhu.bulk-import",
  "name": "批量编辑",
  "description": "把整张待办纸的任务当成一段文本编辑：一行一条，改完整体写回（新增 / 改名 / 删除 / 调序）。",
  "version": "1.1.0",
  "apiVersion": "2.0",
  "stateVersion": 1,
  "entry": "PaperTodo.Plugin.BulkImport.dll",
  "capabilities": [
    "appRuntime"
  ],
  "permissions": [
    "papers.read",
    "todos.read",
    "todos.append",
    "todos.update",
    "todos.delete"
  ],
  "startupPaper": {
    "enabledSetting": "autoStart",
    "instanceKey": "main",
    "presentation": "capsule",
    "title": "批量编辑"
  },
  "settings": [
    {
      "id": "autoStart",
      "type": "boolean",
      "name": "显示「批量编辑」纸片",
      "description": "插件顶栏按钮需要至少一张本插件的纸片才能常驻；关闭后需要手动保留一张插件纸片。",
      "default": true,
      "quick": true
    },
    {
      "id": "stripMarkers",
      "type": "boolean",
      "name": "新行去掉行首序号 / 列表符号",
      "description": "只影响新增的行：去掉 1. / 1、/ - / * / • / □ / [ ] / # 这类行首标记。已有任务不会被改写。",
      "default": true,
      "quick": true
    },
    {
      "id": "dedupeBatch",
      "type": "boolean",
      "name": "新行去重",
      "description": "只影响新增的行：与已有任务或本次新增内容重复的行自动跳过。",
      "default": true,
      "quick": true
    }
  ]
}
